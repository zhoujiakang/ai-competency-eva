# docker compose 会自动读取这个目录下的 .env，照着复制一份即可：
#   cp .env.example .env
#
# 注意：.env 里有密钥，已经在 .gitignore 里，不要提交、不要发群里。

# ---- 必填 ----

# MySQL root 密码：容器首次启动时用它初始化，之后改这里不会改已存在的库
DB_PASSWORD=change-me-db-password

# Java 与 Agent 之间的服务令牌，两边必须一致（随便一串长随机字符）
AGENT_SERVICE_TOKEN=change-me-service-token

# DeepSeek API Key，不填则测评对话不可用
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- 选填 ----

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 对外端口：前端是入口，后端端口只在需要直接调试接口时用
FRONTEND_PORT=8088
BACKEND_PORT=8080

# 允许跨域访问后端的前端来源；前端与接口同源时不需要改
CORS_ORIGINS=http://localhost:4174,http://localhost:3000

# Agent 日志级别：排查问题时设成 DEBUG
AGENT_LOG_LEVEL=INFO
